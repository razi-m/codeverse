# Get a free project id at https://cloud.walletconnect.com (needed for WalletConnect).
# MetaMask-only local dev works with the placeholder.
VITE_WALLETCONNECT_PROJECT_ID=demo
VITE_API_URL=/api

# Supabase phone-OTP auth (farmer/insurer login). The anon key is safe to
# expose here — it's designed to be public, unlike the backend-only
# SUPABASE_SERVICE_ROLE_KEY in backend/.env, which must never appear in
# any VITE_* variable. If unset, login is disabled and lib/AuthContext.tsx
# surfaces a clear "Login is not configured" error rather than pretending
# to work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
