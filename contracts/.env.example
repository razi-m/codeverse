# Only needed to deploy to Ethereum Sepolia (a public TESTNET — no real
# money). Local dev (`npm run chain` / `npm run deploy`) works without
# these; the `sepolia` Hardhat network is only registered when both are
# set (see hardhat.config.js), so an incomplete .env fails clearly at
# `--network sepolia` rather than deploying somewhere unintended.
#
# Get a free RPC URL from https://infura.io or https://alchemy.com.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# NEVER put a wallet with real funds here. Use a throwaway wallet funded
# only from a Sepolia faucet (e.g. https://sepoliafaucet.com) — testnet
# ETH has no monetary value. This key deploys the contract and becomes its
# owner (Ownable) — keep it only in this untracked .env, never commit it,
# never paste it into chat, logs, or code.
DEPLOYER_PRIVATE_KEY=
