PORT=4000
# Local Hardhat node. Swap for an Infura/Alchemy URL to point at a testnet.
RPC_URL=http://127.0.0.1:8545
# Optional: overrides the address in src/deployment.json (written by the deploy script).
CONTRACT_ADDRESS=
CORS_ORIGIN=http://localhost:5173

# Supabase (D1: strictly non-authoritative, off-chain data only). If unset,
# services/supabase.ts degrades every query to null rather than throwing —
# the payout path must work with Supabase unreachable (verified at T2.10).
SUPABASE_URL=
SUPABASE_ANON_KEY=
