PORT=4000

# Declared network intent — "local" (default) or "sepolia". Purely a
# safety check: before any oracle write, the backend confirms RPC_URL is
# actually connected to the chain this says it should be, and refuses
# (loudly, with no transaction sent) if they disagree. Does not itself
# choose RPC_URL/CONTRACT_ADDRESS below — set those to match separately.
BLOCKCHAIN_NETWORK=local

# Local Hardhat node by default. For Sepolia, use the SAME RPC URL you put
# in contracts/.env's SEPOLIA_RPC_URL (Infura/Alchemy free tier).
RPC_URL=http://127.0.0.1:8545
# Optional: overrides the address in src/deployment.json (written by the
# deploy script). Leave unset — the deploy script keeps this file in sync
# automatically for whichever network you last ran `npm run deploy` against.
CONTRACT_ADDRESS=
CORS_ORIGIN=http://localhost:5173

# Oracle simulation harness signing keys (services/oracleHarness.ts). Unset
# by default: the harness derives oracleA/oracleB from Hardhat's public
# default mnemonic, matching what contracts/scripts/seed.js registers — the
# right behaviour for the local demo chain. REQUIRED when
# BLOCKCHAIN_NETWORK=sepolia (the backend refuses to derive oracle signers
# from the public Hardhat mnemonic on a real network) — set both to real
# throwaway testnet private keys, each funded with a little Sepolia ETH
# from a faucet (e.g. https://sepoliafaucet.com) to pay gas, and registered
# as oracles via contracts/scripts/seed.js (or the admin console) on that
# deployment. Never the same key as DEPLOYER_PRIVATE_KEY in contracts/.env.
ORACLE_A_KEY=
ORACLE_B_KEY=

# Supabase (D1: strictly non-authoritative, off-chain data only). If unset,
# services/supabase.ts degrades every query to null rather than throwing —
# the payout path must work with Supabase unreachable (verified at T2.10).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — the one deliberate exception to the anon-only model
# above. Used only by services/supabaseAdmin.ts to reach app_users and
# policy_assignments (backend/sql/002_auth.sql), which carry no anon RLS
# policy at all because they ARE the authorization boundary (farmer
# login, policy ownership, admin roles), unlike every other table which
# is presentational and safe to leave anon-readable. NEVER put this in
# frontend env vars, NEVER log it, NEVER commit it. If unset, all
# authentication/authorization requests fail closed (401/403), never
# open — see middleware/auth.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Which WeatherSource the oracle harness reads from (P9). "simulated"
# (default) uses the deterministic Supabase-backed scenarios — required for
# repeatable judging. "open-meteo" fetches real live rainfall from
# Open-Meteo (free, keyless — no secret to set). "sentinel" fetches real
# live NDVI from Sentinel-2 via Copernicus (needs SENTINEL_CLIENT_ID/SECRET
# below). IMD is not selectable yet: its real API requires an institutional
# key not available in this hackathon session. See docs/handoff.md and
# services/weatherSourceFactory.ts.
WEATHER_SOURCE=simulated

# Sarvam AI (P9: multi-language ledger translation, en -> hi/mr). Absent =
# English only, no error — see services/translate.ts.
SARVAM_API_KEY=

# Copernicus Data Space Ecosystem / Sentinel Hub (P9: Sentinel-2 NDVI, only
# used when WEATHER_SOURCE=sentinel). Self-serve OAuth2 client — create one
# free at dataspace.copernicus.eu after registering. Absent = the sentinel
# source returns no reading rather than throwing at startup.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Twilio — WhatsApp/SMS payout notifications (services/twilio.ts). All
# optional: if unset, notifications are recorded as SKIPPED with a clear
# reason, never faked as sent. Same Twilio account used for Supabase phone
# auth SMS is fine to reuse here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp Sandbox number (e.g. +14155238886) while judges/testers must
# first send "join <sandbox-code>" to it from their own WhatsApp before
# they can receive messages — see docs for the exact sandbox join phrase.
TWILIO_WHATSAPP_FROM=
# A real Twilio phone number capable of sending SMS (used only as the SMS
# fallback when a WhatsApp send actually fails — never a first choice).
TWILIO_SMS_FROM=
# The ONE destination POST /api/notifications/test-whatsapp is allowed to
# send to (E.164, e.g. +91XXXXXXXXXX) — the endpoint never accepts an
# arbitrary number from the request.
NOTIFICATION_TEST_RECIPIENT=

# Voice calls (routes/voiceCall.ts, services/sarvamVoice.ts). A real
# Voice-capable Twilio number — may be the same value as
# TWILIO_WHATSAPP_FROM if that number also has voice capability enabled.
TWILIO_VOICE_FROM=
# Sarvam AI TTS voice (bulbul:v2). Sarvam's own default "shubh" is used if
# unset — set this only to pick a different voice.
SARVAM_VOICE_SPEAKER=
# Public HTTPS URL reaching this backend (e.g. an ngrok tunnel in dev,
# https://xxxx.ngrok-free.app) — REQUIRED for voice calls. Twilio's
# servers fetch TwiML/call-audio from this URL and cannot reach localhost.
PUBLIC_BASE_URL=
